{
  "name": "@moltendb/monorepo",
  "private": true,
  "license": "MIT",
  "version": "2.3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/maximilian27/moltendb-web"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:core": "npm run build --workspace=@moltendb-web/core",
    "build:query": "npm run build --workspace=@moltendb-web/query",
    "build:angular": "npm run build --workspace=@moltendb-web/angular",
    "build:react": "npm run build --workspace=@moltendb-web/react",
    "build:all": "npm run build:core && npm run build:query && npm run build:angular && npm run build:react"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@moltendb-web/core": "^2.2.0",
    "prettier": "^2.8.8"
  },
  "dependencies": {
    "@moltendb-web/query": "^2.2.0"
  }
}
